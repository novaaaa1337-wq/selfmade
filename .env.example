# ---- Server ----
PORT=8787

# Solana RPC used by the server. The public endpoint is heavily rate-limited;
# use a provider like Helius, Triton or QuickNode for real traffic.
RPC_URL=https://api.mainnet-beta.solana.com

# REQUIRED to enable launches. Encrypts every coin's treasury key at rest.
# Use a long random string and back it up: if it's lost, every treasury is lost.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TREASURY_SECRET=

# Optional: upload images/metadata through Pinata instead of pump.fun's IPFS endpoint.
PINATA_JWT=

# Treasury engine: collects creator fees and runs buyback + burn. Off by default.
ENGINE_ENABLED=false
ENGINE_INTERVAL_MIN=10
MIN_CLAIM_SOL=0.01
TREASURY_RESERVE_SOL=0.01

# Launch settings
LAUNCH_BUFFER_SOL=0.03
MIN_DEV_BUY_SOL=0.01
MAX_DEV_BUY_SOL=5
PRIORITY_FEE_SOL=0.0005

# ---- Frontend (read by Vite at build time) ----
# RPC the browser uses to fetch a blockhash before the wallet signs.
VITE_RPC_URL=
